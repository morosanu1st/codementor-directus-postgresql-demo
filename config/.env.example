# Directus ↔ PostgreSQL connection example (do not commit real secrets)

HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://localhost:8055

KEY=replace-with-random-32-plus-chars
SECRET=replace-with-another-random-secret

DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=directus_demo
DB_USER=directus
DB_PASSWORD=replace-me
DB_SSL=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# Optional: CORS for a local frontend
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000
